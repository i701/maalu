# The settings for running Maalu from docker-compose.prod.yml (the compose file reads a `.env` next
# to it). Copy this to `.env` and fill in the three required values:
#
#   curl -fsSLO https://raw.githubusercontent.com/i701/maalu/main/docker-compose.prod.yml
#   curl -fsSLO https://raw.githubusercontent.com/i701/maalu/main/.env.prod.example
#   mv docker-compose.prod.yml compose.yaml && cp .env.prod.example .env
#
# These are NOT the files for `just dev`: those are apps/api/.env.example and apps/web/.env.example.
# Use no quotes and no spaces around `=`.

# ── Required ──────────────────────────────────────────────────────────────────────────────────
# openssl rand -hex 32. Signs the two-factor challenge and encrypts stored two-factor secrets.
# NEVER change or lose it: two-factor would have to be set up again. Keep a copy in a password manager.
SECRET_KEY=
# openssl rand -hex 32. Encrypts the web session cookie (at least 32 characters). Changing it only
# signs everyone out.
SESSION_SECRET=
# Letters and digits only (openssl rand -hex 16 is fine): it goes into a URL.
POSTGRES_PASSWORD=

# ── Optional (the defaults are shown) ─────────────────────────────────────────────────────────
# POSTGRES_USER=maalu
# POSTGRES_DB=maalu
# The port the app is published on. 127.0.0.1:3000 keeps it off the network (use behind a proxy).
# PORT=3000
# Which image to run: latest (follows main), or sha-<commit> for an exact build.
# MAALU_VERSION=latest
# auto: only the first account can sign up. open: anyone. closed: no one.
# REGISTRATION=auto
# Slows down password and code guessing. Leave it on.
# RATE_LIMIT=true

# Map pictures (location picker, Places page). Default: OpenStreetMap's public server.
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=
# Place search by name in the map picker. Default: Nominatim's public server. Set it empty to turn
# it off (nothing a user types is then sent anywhere).
# GEOCODER_URL=

# ── Email (optional): notifications as an email digest, plus a test button in Settings ────────
# Any SMTP provider works. Brevo: smtp-relay.brevo.com, port 587, starttls; the login and the key
# are on its "SMTP & API" page (the key, not your account password). SMTP_FROM must be a sender
# the provider has verified. Leave SMTP_HOST empty and email is off. Each person then switches it
# on for themselves in Settings.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=maalu@yourdomain.com
# SMTP_FROM_NAME=Maalu
# The address you open Maalu at, so emails can link to a page (no trailing slash needed).
# APP_URL=https://maalu.example.com

# ── Receipts: a bucket instead of the volume (AWS S3, Cloudflare R2, MinIO) ───────────────────
# ATTACHMENTS_S3_BUCKET=
# ATTACHMENTS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ATTACHMENTS_S3_REGION=auto
# ATTACHMENTS_S3_ACCESS_KEY_ID=
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=

# ── Nightly backup: scripts/backup.sh (read by that script; compose ignores these lines) ─────
# backup.sh dumps the database, encrypts it with age and uploads it with rclone. Fetch it next to the
# compose file (curl -fsSLO https://raw.githubusercontent.com/i701/maalu/main/scripts/backup.sh) and run it
# from cron. The environment overrides these lines.
# An age PUBLIC key (age1...). Make a pair on your own computer with `age-keygen -o key.txt` and keep
# the private key OFF this machine: a stolen server then cannot read old backups.
# AGE_RECIPIENT=age1...
# Where to upload, as an rclone destination: a SEPARATE bucket from the receipts. Unset = test mode
# (the encrypted dump stays in the folder).
# RCLONE_DEST=r2:maalu-backups
# Delete uploaded backups older than this many days (default 30, 0 keeps everything).
# RETENTION_DAYS=30
# Optional: a Telegram message when the backup FAILS (never on success).
# TG_BOT_TOKEN=
# TG_CHATID=
