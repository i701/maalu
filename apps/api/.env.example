DATABASE_URL=postgresql+asyncpg://maalu:maalu@localhost:5432/maalu
DEBUG=false
SECRET_KEY=change-me-with-openssl-rand-hex-32
# auto (default): sign-up works only until the first account exists; open: anyone; closed: no one
REGISTRATION=auto
# Slows down password guessing, 2FA code guessing and sign-up spam. Leave it on.
RATE_LIMIT=true

# Attachments (receipt photos and PDFs on a transaction). Leave the bucket out and they are kept in
# a folder (ATTACHMENTS_DIR, default data/attachments). Set it to use any S3-compatible store:
# AWS S3, Cloudflare R2 (endpoint https://<account>.r2.cloudflarestorage.com, region auto), MinIO,
# or floci for development (`just storage-up`).
# ATTACHMENTS_S3_BUCKET=maalu-attachments
# ATTACHMENTS_S3_ENDPOINT=http://localhost:4566
# ATTACHMENTS_S3_REGION=us-east-1
# ATTACHMENTS_S3_ACCESS_KEY_ID=test
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=test
