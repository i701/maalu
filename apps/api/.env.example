DATABASE_URL=postgresql+asyncpg://maalu:maalu@localhost:5432/maalu
DEBUG=false
SECRET_KEY=change-me-with-openssl-rand-hex-32
# auto (default): sign-up works only until the first account exists; open: anyone; closed: no one
REGISTRATION=auto
# Slows down password guessing, 2FA code guessing and sign-up spam. Leave it on.
RATE_LIMIT=true

# Attachments (receipt photos and PDFs on a transaction). Leave the bucket out and they are kept in
# a folder (ATTACHMENTS_DIR, default data/attachments). Set it to use any S3-compatible store:
# AWS S3, Cloudflare R2 (endpoint https://<account>.r2.cloudflarestorage.com, region auto), MinIO,
# or floci for development (`just storage-up`).
# ATTACHMENTS_S3_BUCKET=maalu-attachments
# ATTACHMENTS_S3_ENDPOINT=http://localhost:4566
# ATTACHMENTS_S3_REGION=us-east-1
# ATTACHMENTS_S3_ACCESS_KEY_ID=test
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=test

# Optional: searching for a place by name in the map's location picker. It asks a geocoder; what is
# typed into the search box is sent to it, and nothing else. The default is Nominatim's public
# server (light personal use, one request a second, which the app keeps to). Set it empty to turn
# place search off, or point it at your own Nominatim.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ── Email (optional): notifications as an email digest, plus a test button in Settings ────────
# Any SMTP provider works. Brevo: smtp-relay.brevo.com, port 587, starttls; the login and the key
# are on its "SMTP & API" page (the key, not your account password). SMTP_FROM must be a sender
# the provider has verified. Leave SMTP_HOST empty and email is off. Each person then switches it
# on for themselves in Settings.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=maalu@yourdomain.com
# SMTP_FROM_NAME=Maalu
# The address you open Maalu at, so emails can link to a page (no trailing slash needed).
# APP_URL=https://maalu.example.com
