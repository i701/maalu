	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"gen:api": "pnpm dlx --package typescript@5.9.3 --package openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/types/api.generated.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"react-doctor": "react-doctor . --no-supply-chain --no-score -y"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource-variable/roboto": "^5.3.0",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-start": "^1.168.60",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"react-doctor": "^0.9.17",
		"react-scan": "^0.5.7",
