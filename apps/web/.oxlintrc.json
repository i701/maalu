{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": ["src/routeTree.gen.ts", ".output", "dist", "node_modules"],
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
