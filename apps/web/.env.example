# Base URL of the FastAPI service (server-side only; never sent to the browser)
API_URL=http://localhost:8000
# Encrypts the session cookie. At least 32 chars: openssl rand -hex 32
SESSION_SECRET=change-me-with-openssl-rand-hex-32

# Optional: where the map's tiles come from (the location picker and the Places page). The default
# is OpenStreetMap's public server, fine for personal use. To use another (your own tile server, or
# a provider with a key), set the URL template and credit the source.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
